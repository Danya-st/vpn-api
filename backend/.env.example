# ── Сервер ──────────────────────────────────────────────
PORT=4883
# Сколько reverse-proxy перед приложением (для rate-limit по IP). 0 — без прокси.
TRUST_PROXY=0
HTTPS_KEY_PATH= # вставить
HTTPS_CERT_PATH= #вставить
# ── 3x-ui (MHSanaei) ────────────────────────────────────
# Если в панели задан "URI Path" (webBasePath), он ОБЯЗАТЕЛЬНО должен быть в URL:
# XUI_URL=http://host.docker.internal:2053/AbCdEf12
XUI_URL=http://host.docker.internal:2053
# Авторизация — API-токен (3x-ui >= 3.0.2): Настройки панели → Безопасность → API Token → Generate.
# Токен показывается ОДИН раз. Он даёт полный админ-доступ к панели — храните как пароль.
XUI_API_TOKEN=
# Запасной вариант, если токен не задан (двухфакторка не поддерживается). Если задан токен — не нужны.
# XUI_USERNAME=admin
# XUI_PASSWORD=change-me

# Базовый URL подписок 3x-ui = схема+хост+порт+путь подписки из настроек панели (Subscription),
# без завершающего "/". Итоговая ссылка: ${SUB_BASE_URL}/<subId>
SUB_BASE_URL=

# ── ЮKassa ──────────────────────────────────────────────
# Личный кабинет → Интеграция → Ключи API: «shopId» и «Секретный ключ» (см. README).
# Для тестов берите ключи ТЕСТОВОГО магазина (секрет начинается с test_).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# https-страница на вашем домене, куда ЮKassa вернёт пользователя (её отдаёт сам backend):
YOOKASSA_RETURN_URL=https://e-kvn.ru:8443/payment/return
# Куда эта страница отправляет в приложение (deep link, необязательно)
APP_DEEPLINK=myvpn://payment_success
# 1 — отвергать вебхуки не с IP ЮKassa (включайте после проверки по логам, см. README)
YOOKASSA_IP_CHECK=0

# ── Приложение ──────────────────────────────────────────
# Длинная случайная строка: openssl rand -hex 32. Тот же ключ уйдёт в BuildConfig Android.
APP_HMAC_SECRET=

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=myvpn://auth
# Ключ подписи сессионных токенов: openssl rand -hex 32 (смена ключа разлогинит всех)
SESSION_SECRET=
SESSION_TTL_DAYS=90

